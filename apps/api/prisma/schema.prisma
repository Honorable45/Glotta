generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Édition vendue : prix et limites ne sont jamais codés en dur.
model Edition {
  code         String   @id
  name         String
  description  String   @default("")
  /// Prix de vente unique en FCFA.
  price        Int
  maxUsers     Int
  maxStores    Int
  maxDevices   Int      @default(1)
  features     String[]
  /// Grande version du logiciel couverte par une nouvelle vente.
  majorVersion Int      @default(1)
  /// Stockage de synchronisation alloué, en mégaoctets.
  syncQuotaMb  Int      @default(0)
  isActive     Boolean  @default(true)
  licenses     License[]
  sales        Sale[]
}

/// Valeurs configurables depuis la plateforme : durée d'essai, identité du vendeur sur les reçus.
model PlatformSetting {
  key   String @id
  value String
}

model Customer {
  id          String    @id
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  licenses    License[]
  sales       Sale[]
  tickets     SupportTicket[]

  @@index([name])
}

model License {
  id              String       @id
  /// Empreinte pour retrouver la licence, copie chiffrée pour la renvoyer au client.
  keyHash         String       @unique
  keyEncrypted    String
  keyHint         String
  customerId      String
  editionCode     String
  /// PENDING, ACTIVE, SUSPENDED ou REVOKED. PENDING refuse toute activation.
  status          String       @default("PENDING")
  statusReason    String?
  isTrial         Boolean      @default(false)
  trialEndsAt     DateTime?
  // Copiés à l'émission : modifier une édition ne dégrade pas une licence déjà vendue.
  editionName     String
  features        String[]
  maxUsers        Int
  maxStores       Int
  maxDevices      Int
  syncQuotaMb     Int
  maxMajorVersion Int
  syncBytes       BigInt       @default(0)
  createdAt       DateTime     @default(now())
  customer        Customer     @relation(fields: [customerId], references: [id])
  edition         Edition      @relation(fields: [editionCode], references: [code])
  activations     Activation[]
  events          LicenseEvent[]
  sales           Sale[]

  @@index([customerId])
  @@index([status])
}

/// En ajout seul : protégé par un déclencheur.
model LicenseEvent {
  id        String   @id
  licenseId String
  type      String
  details   Json
  actor     String
  createdAt DateTime @default(now())
  license   License  @relation(fields: [licenseId], references: [id])

  @@index([licenseId])
}

model Activation {
  id                String    @id
  licenseId         String
  deviceFingerprint String
  devicePublicKey   String
  deviceName        String
  appVersion        String
  /// ONLINE ou OFFLINE.
  method            String
  lastSeenAt        DateTime?
  /// Libérée par transfert : la place redevient disponible.
  releasedAt        DateTime?
  releaseReason     String?
  createdAt         DateTime  @default(now())
  license           License   @relation(fields: [licenseId], references: [id])

  @@unique([licenseId, deviceFingerprint])
  @@index([licenseId])
}

/// Paiement manuel : seule la confirmation d'un administrateur délivre la licence.
model Sale {
  id               String    @id
  number           Int       @unique @default(autoincrement())
  customerId       String
  editionCode      String
  licenseId        String
  /// NEW : première vente. UPGRADE : droit à une grande version supérieure.
  kind             String    @default("NEW")
  targetMajor      Int
  amount           Int
  /// PENDING, PAID, CANCELLED ou REFUNDED.
  status           String    @default("PENDING")
  paymentMethod    String?
  paymentReference String?
  paidAt           DateTime?
  statusReason     String?
  createdBy        String
  confirmedBy      String?
  createdAt        DateTime  @default(now())
  customer         Customer  @relation(fields: [customerId], references: [id])
  edition          Edition   @relation(fields: [editionCode], references: [code])
  license          License   @relation(fields: [licenseId], references: [id])

  @@index([status])
  @@index([customerId])
}

model SupportTicket {
  id         String   @id
  customerId String
  subject    String
  message    String
  status     String   @default("OPEN")
  reply      String?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
}

model AppRelease {
  id          String   @id
  version     String   @unique
  url         String
  sha512      String
  notes       String
  publishedAt DateTime @default(now())
}

model PlatformAdmin {
  id           String    @id
  email        String    @unique
  name         String    @default("")
  /// OWNER : éditions, remboursements, comptes. ADMIN : clients, ventes, licences.
  role         String    @default("ADMIN")
  passwordHash String
  totpSecret   String
  disabledAt   DateTime?
}

model AdminSession {
  tokenHash String   @id
  adminId   String
  expiresAt DateTime
}

/// En ajout seul : protégé par un déclencheur.
model AdminAuditLog {
  id        String   @id
  adminId   String
  action    String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TechnicalLog {
  id        String   @id
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Contenu chiffré sur les postes : le serveur ne peut pas le lire.
model SyncEnvelope {
  seq          BigInt   @id @default(autoincrement())
  id           String   @unique
  licenseId    String
  activationId String
  ciphertext   String
  createdAt    DateTime @default(now())

  @@index([licenseId, seq])
}
